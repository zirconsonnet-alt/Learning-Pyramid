# Replace every `change-me` value before deploying to a public server.
# For temporary plain-HTTP localhost testing only, you can set PLM_SECURE_COOKIES=false.
PLM_PORT=8001
PLM_APP_MODE=hosted
PLM_SQL_BACKEND=postgres
PLM_POSTGRES_DSN=postgresql://learningpyramid:change-me-postgres-password@postgres:5432/learningpyramid
PLM_POSTGRES_DB=learningpyramid
PLM_POSTGRES_USER=learningpyramid
PLM_POSTGRES_PASSWORD=change-me-postgres-password
PLM_TEST_POSTGRES_PORT=15432
PLM_LOG_LEVEL=INFO
PLM_POSTGRES_CONNECT_TIMEOUT=5
PLM_POSTGRES_POOL_ACQUIRE_TIMEOUT=10
PLM_POSTGRES_POOL_MIN_SIZE=1
PLM_POSTGRES_POOL_MAX_SIZE=8
PLM_POSTGRES_STATEMENT_TIMEOUT_MS=30000
PLM_POSTGRES_LOCK_TIMEOUT_MS=5000
PLM_POSTGRES_IDLE_IN_TX_TIMEOUT_MS=30000
PLM_ENABLE_AUTH=true
PLM_ALLOW_SIGNUP=false
PLM_ENABLE_AUTH_RATE_LIMITS=true
PLM_AUTH_LOGIN_WINDOW_SECONDS=600
PLM_AUTH_LOGIN_MAX_FAILURES_PER_IP=20
PLM_AUTH_LOGIN_MAX_FAILURES_PER_EMAIL=8
PLM_AUTH_SIGNUP_WINDOW_SECONDS=3600
PLM_AUTH_SIGNUP_MAX_ATTEMPTS_PER_IP=8
PLM_AUTH_SIGNUP_MAX_ATTEMPTS_PER_EMAIL=3
PLM_AUTH_RATE_LIMIT_RETENTION_SECONDS=86400
PLM_ENABLE_COMMUNITY_GUARDRAILS=true
PLM_STUDY_GROUP_CREATE_MIN_ACCOUNT_AGE_SECONDS=600
PLM_STUDY_GROUP_CREATE_WINDOW_SECONDS=3600
PLM_STUDY_GROUP_CREATE_MAX_ACTIONS_PER_WINDOW=2
PLM_STUDY_GROUP_JOIN_MIN_ACCOUNT_AGE_SECONDS=120
PLM_STUDY_GROUP_JOIN_WINDOW_SECONDS=900
PLM_STUDY_GROUP_JOIN_MAX_ACTIONS_PER_WINDOW=8
PLM_STUDY_GROUP_JOIN_REQUEST_MIN_ACCOUNT_AGE_SECONDS=120
PLM_STUDY_GROUP_JOIN_REQUEST_WINDOW_SECONDS=1800
PLM_STUDY_GROUP_JOIN_REQUEST_MAX_ACTIONS_PER_WINDOW=5
PLM_STUDY_GROUP_POST_MIN_ACCOUNT_AGE_SECONDS=180
PLM_STUDY_GROUP_POST_WINDOW_SECONDS=600
PLM_STUDY_GROUP_POST_MAX_ACTIONS_PER_WINDOW=5
PLM_STUDY_GROUP_COMMENT_MIN_ACCOUNT_AGE_SECONDS=120
PLM_STUDY_GROUP_COMMENT_WINDOW_SECONDS=600
PLM_STUDY_GROUP_COMMENT_MAX_ACTIONS_PER_WINDOW=12
PLM_ENABLE_ASR=false
PLM_ENABLE_SERVER_MEDIA_STREAM=false
PLM_ENABLE_BROWSER_LOCAL_MEDIA=true
PLM_ENABLE_API_DOCS=false
PLM_ENABLE_MANUAL_TEST_PAYMENT=false
PLM_SECURE_COOKIES=true
PLM_PUBLIC_ORIGIN=
PLM_ALLOWED_ORIGINS=
PLM_TRUSTED_HOSTS=
PLM_PROXY_HEADERS=true
PLM_FORWARDED_ALLOW_IPS=127.0.0.1
PLM_PUBLIC_HOST=
PLM_MEDIA_ACCESS_TOKEN_TTL_SECONDS=14400
PLM_MEDIA_ACCESS_TOKEN_SECRET=change-me-long-random-media-token-secret

# Optional: use a PyPI mirror if the server reaches pypi.org / files.pythonhosted.org slowly.
PLM_PIP_INDEX_URL=
PLM_PIP_EXTRA_INDEX_URL=
PLM_PIP_TRUSTED_HOST=
PLM_PIP_DEFAULT_TIMEOUT=120
PLM_PIP_RETRIES=10

# Optional: enable real WeChat Native membership payment after filling all values.
PLM_WECHAT_PAY_APP_ID=
PLM_WECHAT_PAY_MCH_ID=
PLM_WECHAT_PAY_CERT_SERIAL_NO=
PLM_WECHAT_PAY_API_V3_KEY=
PLM_WECHAT_PAY_PRIVATE_KEY_PEM_PATH=
PLM_WECHAT_PAY_PUBLIC_KEY_ID=
PLM_WECHAT_PAY_PUBLIC_KEY_PEM_PATH=
PLM_WECHAT_PAY_NOTIFY_URL=
PLM_WECHAT_PAY_REFUND_NOTIFY_URL=
PLM_WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
PLM_WECHAT_PAY_TIMEOUT_SECONDS=10
PLM_WECHAT_PAY_DESCRIPTION_PREFIX=LearningPyramid 月会员

# Optional: pending wechat_native membership payment reconciliation task defaults.
PLM_MEMBERSHIP_PENDING_PAYMENT_RECONCILE_MIN_AGE_MINUTES=5
PLM_MEMBERSHIP_PENDING_PAYMENT_RECONCILE_LIMIT=100
