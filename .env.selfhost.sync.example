# Optional deploy-time overlay.
# Copy this file to .env.selfhost.sync, fill the real values locally, and keep that real file out of git.
# Sync-Selfhost-Server.bat will merge .env.selfhost.sync into the server's app/.env automatically on deploy.

PLM_ENABLE_BAIDU_NETDISK=false
PLM_PUBLIC_ORIGIN=https://plm.xuebao.chat
PLM_ALLOWED_ORIGINS=https://plm.xuebao.chat
PLM_TRUSTED_HOSTS=plm.xuebao.chat
PLM_PUBLIC_HOST=plm.xuebao.chat
