FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PLM_DATA_DIR=/data

ARG PIP_INDEX_URL=
ARG PIP_EXTRA_INDEX_URL=
ARG PIP_TRUSTED_HOST=
ARG PIP_DEFAULT_TIMEOUT=120
ARG PIP_RETRIES=10
ARG PLM_FRONTEND_DIST_FINGERPRINT=

WORKDIR /app

COPY requirements.txt ./
RUN set -eux; \
    install_args="--no-cache-dir --default-timeout=${PIP_DEFAULT_TIMEOUT} --retries ${PIP_RETRIES}"; \
    if [ -n "${PIP_INDEX_URL}" ]; then install_args="${install_args} --index-url ${PIP_INDEX_URL}"; fi; \
    if [ -n "${PIP_EXTRA_INDEX_URL}" ]; then install_args="${install_args} --extra-index-url ${PIP_EXTRA_INDEX_URL}"; fi; \
    if [ -n "${PIP_TRUSTED_HOST}" ]; then install_args="${install_args} --trusted-host ${PIP_TRUSTED_HOST}"; fi; \
    python -m pip install ${install_args} -r requirements.txt

COPY adapter ./adapter
COPY backend ./backend
COPY tools ./tools
COPY README.md ./
COPY docs ./docs
ENV PLM_FRONTEND_DIST_FINGERPRINT=${PLM_FRONTEND_DIST_FINGERPRINT}
COPY frontend/dist ./frontend/dist

EXPOSE 8001

CMD ["python", "tools/run_hosted_server.py"]
